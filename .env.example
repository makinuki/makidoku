# MakiDoku environment configuration.
# Copy this file to .env and edit as needed. All variables are optional.

# Directory for makidoku.db, the WASM cache, and downloaded manga.
# Defaults to ./data relative to the current working directory.
# Equivalent to --data-dir.
MAKIDOKU_DATA_DIR=

# Source catalog location. Accepts an index.json URL, or a path to a local
# mirror of the published layout for offline installs. Defaults to the public
# registry. Equivalent to --registry.
MAKIDOKU_REGISTRY_URL=

# How long a request blocked by an anti-bot challenge waits for clearance to be
# submitted through the API before it fails, for example 2m. Unset or zero
# fails the request immediately. Equivalent to --challenge-wait.
MAKIDOKU_CHALLENGE_WAIT=

# Download artifact directory. Defaults to <data-dir>/downloads.
# Equivalent to --download-dir.
MAKIDOKU_DOWNLOAD_DIR=

# Number of chapter downloads processed concurrently. Defaults to 3.
# Equivalent to --workers.
MAKIDOKU_DOWNLOAD_WORKERS=3

# Minimum interval between page image requests to the same domain.
# Defaults to 500ms. Equivalent to --page-interval.
MAKIDOKU_PAGE_INTERVAL=500ms

# Set to 1 when running tests that install live sources and access the network.
MAKIDOKU_NETWORK_TESTS=
